{
  "name": "weight-logic",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k 'alchemy dev --stage local' 'vite --host 127.0.0.1'",
    "seed": "node scripts/seed.ts",
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint src tests scripts",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "deploy": "pnpm build && node --env-file=.env ./node_modules/alchemy/bin/cli.js deploy --stage production --yes"
  },
  "packageManager": "pnpm@10.33.2",
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@weight-logic/domain": "workspace:*",
    "better-auth": "1.7.7",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.4.0",
    "effect": "4.0.3",
    "fraction.js": "5.3.4",
    "input-otp": "^1.5.0",
    "lucide-react": "1.55.0",
    "radix-ui": "^1.7.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "shadcn": "^4.21.4",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261011.1",
    "@effect/platform-node": "4.0.3",
    "@playwright/test": "1.64.0",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "alchemy": "2.0.0-beta.81",
    "concurrently": "10.0.6",
    "oxlint": "1.87.0",
    "prettier": "3.9.10",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "vite": "8.3.4",
    "vitest": "5.0.3"
  }
